rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // Shared Hardened Primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isVerified() && request.auth.token.email == 'emailshahir@gmail.com';
    }

    function isExpectedAccessKey(val) {
      return val is string
        && val.size() == 64
        && val == '2c5653d9206c3eb9d3f60f8d9ec778050dc73e9b4b8bb1d5aef1230a58b18f78';
    }

    function hasValidAccessKey(data) {
      return data.keys().hasAny(['accessKey']) && isExpectedAccessKey(data.accessKey);
    }

    function isValidDateString(val) {
      return val is string && val.size() == 10 && val.matches('^\\d{4}-\\d{2}-\\d{2}$');
    }

    // Validation Blueprint: Booking
    function isValidBooking(data) {
      return data.keys().hasAll([
        'userId', 'unitType', 'guestName', 'state',
        'checkIn', 'checkOut', 'accountNumber',
        'nights', 'totalAmount', 'status', 'createdAt', 'updatedAt'
      ])
      && data.keys().hasOnly([
        'userId', 'unitType', 'guestName', 'phone', 'state',
        'checkIn', 'checkOut', 'accountNumber',
        'nights', 'discountAmount', 'totalAmount', 'status', 'createdAt', 'updatedAt', 'accessKey'
      ])
      && data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128
      && data.unitType in ['homestay', 'roomstay']
      && data.guestName is string && data.guestName.size() >= 2 && data.guestName.size() <= 100
      && (!data.keys().hasAny(['phone']) || (data.phone is string && data.phone.size() <= 24))
      && (!data.keys().hasAny(['accessKey']) || (data.accessKey is string && data.accessKey.size() == 64 && data.accessKey.matches('^[a-f0-9]{64}$')))
      && data.state is string && data.state.size() >= 2 && data.state.size() <= 50
      && isValidDateString(data.checkIn)
      && isValidDateString(data.checkOut)
      && data.checkOut > data.checkIn
      && data.accountNumber is string && data.accountNumber.size() >= 4 && data.accountNumber.size() <= 34
      && data.accountNumber.matches('^[0-9A-Za-z\\-\\s]{4,34}$')
      && data.nights is int && data.nights >= 1 && data.nights <= 60
      && (!data.keys().hasAny(['discountAmount']) || ((data.discountAmount is int || data.discountAmount is float) && data.discountAmount >= 0 && data.discountAmount <= 100000))
      && (data.totalAmount is int || data.totalAmount is float) && data.totalAmount >= 0 && data.totalAmount <= 100000
      && data.status in ['confirmed', 'cancelled']
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    // Validation Blueprint: AvailabilitySlot (Public Non-PII)
    function isValidAvailabilitySlot(data) {
      return data.keys().hasAll([
        'bookingId', 'userId', 'unitType', 'checkIn', 'checkOut', 'status', 'createdAt'
      ])
      && data.keys().hasOnly([
        'bookingId', 'userId', 'unitType', 'checkIn', 'checkOut', 'status', 'createdAt'
      ])
      && isValidId(data.bookingId)
      && data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128
      && data.unitType in ['homestay', 'roomstay']
      && isValidDateString(data.checkIn)
      && isValidDateString(data.checkOut)
      && data.checkOut > data.checkIn
      && data.status in ['confirmed', 'cancelled']
      && data.createdAt is timestamp;
    }

    // Validation Blueprint: Feedback
    function isValidFeedback(data) {
      return data.keys().hasAll([
        'userId', 'authorName', 'stayType', 'rating', 'comment', 'createdAt'
      ])
      && data.keys().hasOnly([
        'userId', 'authorName', 'stayType', 'rating', 'comment', 'createdAt'
      ])
      && data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128
      && data.authorName is string && data.authorName.size() >= 2 && data.authorName.size() <= 80
      && data.stayType in ['homestay', 'roomstay']
      && data.rating is int && data.rating >= 1 && data.rating <= 5
      && data.comment is string && data.comment.size() >= 5 && data.comment.size() <= 600
      && data.createdAt is timestamp;
    }

    // Validation Blueprint: AppSetting
    function isValidAppSetting(data) {
      return data.keys().hasAll([
        'webhookUrl', 'sheetLabel', 'accessKey', 'createdAt', 'updatedAt'
      ])
      && data.keys().hasOnly([
        'webhookUrl', 'sheetLabel', 'accessKey', 'createdAt', 'updatedAt'
      ])
      && data.webhookUrl is string && data.webhookUrl.size() >= 45 && data.webhookUrl.size() <= 400
      && data.webhookUrl.matches('^https://script\\.google\\.com/macros/s/[a-zA-Z0-9_\\-]+/exec$')
      && data.sheetLabel is string && data.sheetLabel.size() >= 1 && data.sheetLabel.size() <= 100
      && isExpectedAccessKey(data.accessKey)
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    // Bookings Collection (Passcode-Authorized Without Account Login + Primary Admin Override)
    match /bookings/{bookingId} {
      allow get: if isValidId(bookingId) && (isAdmin() || hasValidAccessKey(existing()));
      allow list: if isAdmin() || hasValidAccessKey(existing());
      allow create: if isValidId(bookingId)
        && isValidBooking(incoming())
        && (
          (isAdmin() && incoming().userId == request.auth.uid)
          || hasValidAccessKey(incoming())
        )
        && incoming().status == 'confirmed'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && existsAfter(/databases/$(database)/documents/availability_slots/$(bookingId));
      allow update: if isValidId(bookingId)
        && isValidBooking(incoming())
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin()
          || (
            hasValidAccessKey(existing())
            && incoming().accessKey == existing().accessKey
            && existing().status == 'confirmed'
            && incoming().status == 'cancelled'
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
          )
        );
      allow delete: if isValidId(bookingId) && (isAdmin() || hasValidAccessKey(existing()));
    }

    // Public Calendar Availability Slots (Read-Only for Public, Atomic Passcode/Admin Writes)
    match /availability_slots/{slotId} {
      allow get: if isValidId(slotId);
      allow list: if true;
      allow create: if isValidId(slotId)
        && isValidAvailabilitySlot(incoming())
        && incoming().bookingId == slotId
        && incoming().status == 'confirmed'
        && incoming().createdAt == request.time
        && existsAfter(/databases/$(database)/documents/bookings/$(slotId))
        && (
          (isAdmin() && incoming().userId == request.auth.uid)
          || (
            hasValidAccessKey(getAfter(/databases/$(database)/documents/bookings/$(slotId)).data)
            && incoming().userId == getAfter(/databases/$(database)/documents/bookings/$(slotId)).data.userId
          )
        );
      allow update: if isValidId(slotId)
        && isValidAvailabilitySlot(incoming())
        && incoming().bookingId == existing().bookingId
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt
        && (
          isAdmin()
          || (
            existing().status == 'confirmed'
            && incoming().status == 'cancelled'
            && incoming().diff(existing()).affectedKeys().hasOnly(['status'])
            && hasValidAccessKey(get(/databases/$(database)/documents/bookings/$(slotId)).data)
            && getAfter(/databases/$(database)/documents/bookings/$(slotId)).data.status == 'cancelled'
          )
        );
      allow delete: if isValidId(slotId) && (isAdmin() || hasValidAccessKey(get(/databases/$(database)/documents/bookings/$(slotId)).data));
    }

    // Public Guest Feedback Collection
    match /feedbacks/{feedbackId} {
      allow get: if isValidId(feedbackId);
      allow list: if true;
      allow create: if isSignedIn()
        && isVerified()
        && isValidId(feedbackId)
        && isValidFeedback(incoming())
        && incoming().userId == request.auth.uid
        && incoming().createdAt == request.time;
      allow update: if isAdmin()
        && isValidId(feedbackId)
        && isValidFeedback(incoming())
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt;
      allow delete: if isValidId(feedbackId) && isSignedIn() && (
        existing().userId == request.auth.uid || isAdmin()
      );
    }

    // Passcode-Protected App Settings (e.g. Google Sheet Apps Script Web App URL)
    match /app_settings/{settingId} {
      allow get: if isValidId(settingId) && (isAdmin() || hasValidAccessKey(existing()));
      allow list: if isAdmin() || hasValidAccessKey(existing());
      allow create: if isValidId(settingId)
        && isValidAppSetting(incoming())
        && (isAdmin() || hasValidAccessKey(incoming()))
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(settingId)
        && isValidAppSetting(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin()
          || (
            hasValidAccessKey(existing())
            && incoming().accessKey == existing().accessKey
            && incoming().diff(existing()).affectedKeys().hasOnly(['webhookUrl', 'sheetLabel', 'updatedAt'])
          )
        );
      allow delete: if isValidId(settingId) && (isAdmin() || hasValidAccessKey(existing()));
    }

    // Health check doc for connection test
    match /test/connection {
      allow get: if true;
    }
  }
}
