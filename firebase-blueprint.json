{
  "entities": {
    "Booking": {
      "title": "Booking",
      "description": "Private homestay or roomstay reservation record containing guest details, dates, bank account reference, and calculated total.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "Firebase Auth UID of the guest who created the booking."
        },
        "unitType": {
          "type": "string",
          "enum": ["homestay", "roomstay"],
          "description": "Selected accommodation type."
        },
        "guestName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100,
          "description": "Full name of the guest."
        },
        "phone": {
          "type": "string",
          "minLength": 0,
          "maxLength": 24,
          "description": "Guest phone number."
        },
        "state": {
          "type": "string",
          "minLength": 2,
          "maxLength": 50,
          "description": "Malaysian state of origin."
        },
        "checkIn": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "Check-in date in YYYY-MM-DD format."
        },
        "checkOut": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "Check-out date in YYYY-MM-DD format."
        },
        "accountNumber": {
          "type": "string",
          "minLength": 4,
          "maxLength": 34,
          "pattern": "^[0-9A-Za-z\\-\\s]{4,34}$",
          "description": "Guest bank account or payment reference number."
        },
        "nights": {
          "type": "number",
          "description": "Number of nights stayed."
        },
        "discountAmount": {
          "type": "number",
          "description": "Discount amount in MYR deducted from subtotal."
        },
        "totalAmount": {
          "type": "number",
          "description": "Total booking amount in MYR."
        },
        "status": {
          "type": "string",
          "enum": ["confirmed", "cancelled"],
          "description": "Current reservation status."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when booking was created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when booking was last updated."
        },
        "accessKey": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[a-f0-9]{64}$",
          "description": "Passcode-derived access key hash authorizing password-only admin operations."
        }
      },
      "required": [
        "userId",
        "unitType",
        "guestName",
        "state",
        "checkIn",
        "checkOut",
        "accountNumber",
        "nights",
        "totalAmount",
        "status",
        "createdAt",
        "updatedAt"
      ]
    },
    "AvailabilitySlot": {
      "title": "AvailabilitySlot",
      "description": "Non-PII public calendar occupancy slot synchronized atomically with a booking.",
      "type": "object",
      "properties": {
        "bookingId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Associated booking document ID."
        },
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "UID of the guest who holds this slot."
        },
        "unitType": {
          "type": "string",
          "enum": ["homestay", "roomstay"],
          "description": "Accommodation unit type."
        },
        "checkIn": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "Check-in date in YYYY-MM-DD format."
        },
        "checkOut": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "Check-out date in YYYY-MM-DD format."
        },
        "status": {
          "type": "string",
          "enum": ["confirmed", "cancelled"],
          "description": "Slot occupancy status."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when slot was created."
        }
      },
      "required": [
        "bookingId",
        "userId",
        "unitType",
        "checkIn",
        "checkOut",
        "status",
        "createdAt"
      ]
    },
    "Feedback": {
      "title": "Feedback",
      "description": "Public guest review for Ss Homestay or Ss Roomstay.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "UID of the reviewer."
        },
        "authorName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80,
          "description": "Display name of the guest."
        },
        "stayType": {
          "type": "string",
          "enum": ["homestay", "roomstay"],
          "description": "Unit type reviewed."
        },
        "rating": {
          "type": "number",
          "description": "Star rating between 1 and 5."
        },
        "comment": {
          "type": "string",
          "minLength": 5,
          "maxLength": 600,
          "description": "Guest review message."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when review was submitted."
        }
      },
      "required": [
        "userId",
        "authorName",
        "stayType",
        "rating",
        "comment",
        "createdAt"
      ]
    },
    "AppSetting": {
      "title": "AppSetting",
      "description": "Passcode-protected application configuration such as Google Apps Script Web App webhook URL.",
      "type": "object",
      "properties": {
        "webhookUrl": {
          "type": "string",
          "minLength": 45,
          "maxLength": 400,
          "pattern": "^https://script\\.google\\.com/macros/s/[a-zA-Z0-9_\\-]+/exec$",
          "description": "Google Apps Script Web App URL for password-only Google Sheet sync."
        },
        "sheetLabel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "Display label for the connected Google Sheet."
        },
        "accessKey": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[a-f0-9]{64}$",
          "description": "Passcode-derived access key hash authorizing admin settings."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when setting was created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when setting was last updated."
        }
      },
      "required": [
        "webhookUrl",
        "sheetLabel",
        "accessKey",
        "createdAt",
        "updatedAt"
      ]
    },
    "FinanceEntry": {
      "title": "FinanceEntry",
      "description": "Admin financial ledger record for expenses (Wang Keluar) or manual income (Wang Masuk) synchronized with Google Sheet.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "Admin UID or passcode actor identifier."
        },
        "date": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "Transaction date in YYYY-MM-DD format."
        },
        "entryType": {
          "type": "string",
          "enum": ["expense", "income"],
          "description": "Whether the entry is Wang Keluar (expense) or Wang Masuk (income)."
        },
        "perkara": {
          "type": "string",
          "minLength": 2,
          "maxLength": 200,
          "description": "Description of the financial transaction (Perkara)."
        },
        "amount": {
          "type": "number",
          "description": "Transaction amount in MYR."
        },
        "syncedToSheet": {
          "type": "boolean",
          "description": "Whether this entry has been confirmed written to Google Sheet."
        },
        "accessKey": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[a-f0-9]{64}$",
          "description": "Passcode-derived access key hash authorizing admin financial records."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when entry was created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when entry was last updated."
        }
      },
      "required": [
        "userId",
        "date",
        "entryType",
        "perkara",
        "amount",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/bookings/{bookingId}": {
      "schema": { "$ref": "#/entities/Booking" },
      "description": "Private reservation records readable only by the booking owner or admin."
    },
    "/availability_slots/{slotId}": {
      "schema": { "$ref": "#/entities/AvailabilitySlot" },
      "description": "Public non-PII date occupancy slots for calendar availability display."
    },
    "/feedbacks/{feedbackId}": {
      "schema": { "$ref": "#/entities/Feedback" },
      "description": "Guest testimonials and feedback for Ss Homestay and Roomstay."
    },
    "/app_settings/{settingId}": {
      "schema": { "$ref": "#/entities/AppSetting" },
      "description": "Admin-protected configuration for persistent Google Sheet Apps Script integration."
    },
    "/finance_entries/{entryId}": {
      "schema": { "$ref": "#/entities/FinanceEntry" },
      "description": "Admin-protected financial ledger entries (Wang Keluar & manual Wang Masuk)."
    }
  }
}
